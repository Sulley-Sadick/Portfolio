# Copy values into repo Settings → Secrets and variables → Actions (names must match).

# GitHub Pages (CI sets VITE_BASE_PATH=/Portfolio/ in the workflow)
VITE_BASE_PATH=/
VITE_APP_URL=https://sulley-sadick.github.io/Portfolio/

VITE_GITHUB_LINK=
VITE_WHATSAPP_LINK=
VITE_EMAIL_LINK=
# Path under public/ (base /Portfolio/ is added at build). Or use full https URL.
VITE_RESUME_LINK=resume/Sulley-Sadick-Resume.pdf
VITE_LINKEDIN_LINK=
VITE_INSTAGRAM_LINK=
VITE_FACEBOOK_LINK=
VITE_PHONE_NUMBER=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHER_KEY=
# Optional; defaults to VITE_APP_URL when unset
VITE_SERVER_URI=

# Optional — paste the content value from Google Search Console HTML verification
VITE_GOOGLE_SITE_VERIFICATION=
